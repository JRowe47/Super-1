{
  "teacher": "Qwen/Qwen3-0.6B-Base",
  "vocab_size": 151936,
  "data": "data/qwen3-06b-representation",
  "token_dtype": "uint32",
  "student_parameter_budget": 120000000,
  "arms": {
    "recurrent_full_kl": {
      "architecture": "recurrent_logits",
      "embedding_initialization": "random",
      "branching": false
    },
    "hierarchical_full_kl": {
      "architecture": "hierarchical_distribution",
      "embedding_initialization": "random",
      "branching": false
    },
    "hierarchical_embed_full_kl": {
      "architecture": "hierarchical_distribution",
      "embedding_initialization": "qwen_pca",
      "branching": false
    },
    "hierarchical_branch_distill": {
      "architecture": "hierarchical_distribution",
      "embedding_initialization": "qwen_pca",
      "branching": true
    }
  },
  "models": {
    "recurrent_logits": {
      "minimum_width": 256,
      "maximum_width": 1024,
      "width_step": 8,
      "layers": 8
    },
    "hierarchical_distribution": {
      "minimum_width": 256,
      "maximum_width": 1024,
      "width_step": 8,
      "segment_length": 32,
      "document_segments": 8
    }
  },
  "training": {
    "context": 512,
    "batch_size": 4,
    "max_tokens": 10000000,
    "learning_rate": 0.0003,
    "warmup_steps": 500,
    "minimum_lr_ratio": 0.1,
    "betas": [0.9, 0.95],
    "weight_decay": 0.1,
    "gradient_clip": 1.0,
    "seed": 6501,
    "ce_weight": 0.1,
    "distribution_weight": 1.0,
    "temperatures": [
      {"value": 1.0, "weight": 0.5},
      {"value": 2.0, "weight": 0.3},
      {"value": 4.0, "weight": 0.2}
    ],
    "vocab_chunk_size": 8192,
    "log_every": 20,
    "checkpoint_every": 500,
    "branching": {
      "every": 4,
      "weight": 1.0,
      "minimum_prefix": 64,
      "maximum_prefix": 448,
      "rollout_steps": 2,
      "candidates": [
        {"kind": "teacher_top1"},
        {"kind": "teacher_sample", "temperature": 1.0},
        {"kind": "teacher_rank", "rank": 32},
        {"kind": "student_sample", "temperature": 1.0}
      ]
    }
  },
  "embedding_projection": {
    "chunk_size": 4096,
    "preserve_global_norm": true
  },
  "evaluation": {
    "context": 512,
    "batch_size": 2,
    "batches": 16,
    "branch_batches": 2,
    "seed": 8501,
    "rollout_positions": [64, 128, 256, 512],
    "temperatures": [
      {"value": 1.0, "weight": 0.5},
      {"value": 2.0, "weight": 0.3},
      {"value": 4.0, "weight": 0.2}
    ]
  },
  "benchmark": {
    "limit": 1000,
    "log_every": 100
  },
  "promotion_gates": {
    "minimum_ce_improvement": 0.01,
    "minimum_branch_kl_improvement": 0.01,
    "maximum_rollout_ce_degradation": 0.1,
    "maximum_budget_utilization_spread": 0.03
  },
  "safety": {
    "minimum_free_gb": 20
  }
}
